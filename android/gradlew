#!/usr/bin/env bash

##############################################################################
##
##  Gradle start up script for UN*X
##
##############################################################################

# Attempt to set APP_HOME
# Resolve links: $0 may be a symlink
pro="$0"
# Need this for relative symlinks.
while [ -h "$pro" ] ; do
    ls=`ls -ld "$pro"`
    link=`expr "$ls" : '.*-> \(.*\)$'`
    if expr "$link" : '/.*' > /dev/null; then
        pro="$link"
    else
        pro=`dirname "$pro"`"/$link"
    fi
done

cd "`dirname "$pro"`" || exit 1
app_path="`pwd -P`"
cd "`dirname "$app_path"`" || exit 1
APP_HOME="`pwd -P`"

# Add default JVM options here.
DEFAULT_JVM_OPTS='"@/etc/gradle/gradle.jvmopts"' '"@/usr/local/lib/gradle/gradle.jvmopts"' '"@/usr/lib/gradle/gradle.jvmopts"' '"@/usr/local/etc/gradle/gradle.jvmopts"'

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD="maximum"

warn ( ) {
    echo "$*" >&2
}

die ( ) {
    echo
    echo "$*" >&2
    exit 1
}

# OS specific support (must be 'true' or 'false').
case "`uname`" in
  CYGWIN* )
    cygwin=true
    ;;
  Darwin* )
    darwin=true
    ;;
  MSYS* )
    msys=true
    ;;
  MINGW* )
    msys=true
    ;;
esac

# For Cygwin or MSYS, switch paths to Windows format before running java
if [ "$cygwin" = "true" ] -o [ "$msys" = "true" ] ; then
    APP_HOME=`cygpath --path --mixed "$APP_HOME"`
    APP_HOME_PATTERN=`cygpath --path --mixed "$APP_HOME"`
    CLASSPATH=`cygpath --path --mixed "$CLASSPATH"`
fi

cd "$APP_HOME"

# By default we should be in the correct project dir, but when run from Gradle we
# might be in the wrapper's working dir.
if [ ! -d "gradle" ]; then
    die "Gradle directory not found: $APP_HOME/gradle"
fi

exec ./gradlew "$@"