{
  "name": "accounting-app",
  "displayName": "حسابداری",
  "version": "4.6.9",
  "private": true,
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "web": "react-scripts start",
    "start": "react-native start",
    "test": "jest",
    "build:android": "cd android && ./gradlew clean assembleRelease && cd ..",
    "build:android:debug": "cd android && ./gradlew clean assembleDebug && cd ..",
    "build:ios": "cd ios && xcodebuild -workspace accounting-app.xcworkspace -scheme accounting-app -configuration Release && cd ..",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "server": "node server.js"
  },
  "dependencies": {
    "react-native": "0.73.0",
    "react-native-web": "^0.19.0",
    "@react-native-community/hooks": "^3.0.0",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "react-native-sqlite-storage": "^6.0.0",
    "realm": "^12.10.0",
    "axios": "^1.6.2",
    "date-fns-jalali": "^2.0.0",
    "chart.js": "^4.4.0",
    "react-native-charts-wrapper": "^1.3.6",
    "react-native-svg": "^13.14.0",
    "react-native-voice": "^3.2.4",
    "react-native-push-notification": "^8.1.1",
    "react-native-fingerprint-scanner": "^10.0.1",
    "react-native-permissions": "^3.10.0",
    "react-native-file-access": "^3.0.4",
    "react-native-document-picker": "^9.1.1",
    "react-native-share": "^8.2.0",
    "expo": "^50.0.0",
    "expo-sqlite": "^13.0.0",
    "expo-permissions": "^14.4.0",
    "expo-voice": "^1.3.0",
    "react-navigation": "^6.1.9",
    "react-navigation-bottom-tabs": "^6.5.11",
    "react-navigation-drawer": "^6.6.9",
    "react-navigation-stack": "^6.3.20",
    "@react-navigation/native": "^6.1.9",
    "react-native-screens": "^3.27.0",
    "react-native-safe-area-context": "^4.8.2",
    "react-native-gesture-handler": "^2.14.1",
    "react-native-reanimated": "^3.5.0",
    "react-native-elements": "^3.4.3",
    "react-native-vector-icons": "^10.0.0",
    "react-native-uuid": "^2.0.1",
    "i18next": "^23.7.6",
    "react-i18next": "^13.5.0",
    "react": "18.2.0",
    "expo-constants": "~15.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@babel/preset-env": "^7.23.3",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@types/react": "^18.2.37",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.3.2",
    "babel-loader": "^9.1.3",
    "react-native-builder-bob": "^0.21.3",
    "jest": "^29.7.0",
    "@testing-library/react-native": "^12.1.2",
    "eslint": "^8.52.0",
    "prettier": "^3.0.3",
    "@react-native/metro-config": "^0.73.7"
  },
  "jest": {
    "preset": "react-native",
    "testEnvironment": "node"
  }
}